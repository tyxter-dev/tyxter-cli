{
  "name": "@tyxter/cli",
  "version": "0.1.0",
  "description": "Tyxter CLI for local webhook testing.",
  "type": "module",
  "bin": {
    "tyxter": "./dist/main.js"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/main.ts",
    "doctor": "tsx src/main.ts doctor",
    "start": "node dist/main.js",
    "status": "tsx src/main.ts status",
    "tour:demo": "node scripts/tour-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm build",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.js.map",
    "README.md"
  ]
}
